# Conexión a Base de Datos PostgreSQL (Neon, Supabase, Vercel Postgres, etc.)
DATABASE_URL="postgresql://usuario:contraseña@host:5432/nombre_db?sslmode=require"

# Configuración de Acceso al Panel de Administración
ADMIN_USER="admin@example.com"
ADMIN_PASSWORD="tu_password_seguro"
AUTH_SECRET="tu-clave-secreta-aleatoria-para-firmar-sesiones-de-administrador"

# Correos autorizados para recuperación de contraseña (separados por coma)
AUTHORIZED_RECOVERY_EMAILS="raqtal@hotmail.com,playalazenia@gmail.com"

# Configuración del Sitio
NEXT_PUBLIC_SITE_URL="https://pinadasun.com"

# Configuración de Envío de Emails (Resend)
RESEND_API_KEY="re_tu_clave_de_resend_aqui"
# RESEND_FROM_EMAIL="reservas@pinadasun.com" # Opcional: Remitente verificado
